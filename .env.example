# Supabase — Project Settings → API
# Project URL only — do NOT append /rest/v1/ or any other path
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (formerly "anon" / "public")
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only secret key — required for invite/onboarding admin operations.
# Do not expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Optional — public app URL used in invitation redirect links
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — Google Maps Embed API key for venue map iframes
# (without it, venue pages still embed via a maps search query)
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=your-maps-embed-api-key
